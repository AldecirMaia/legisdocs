generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// === ENUMS (Regras de Negócio) ===

enum Role {
    SUPER_ADMIN
    SECRETARIA
    VEREADOR
    ASSESSOR
}

enum DocumentType {
    INDICACAO
    REQUERIMENTO
    PROJETO_LEI_LEGISLATIVO // Substituiu PROJETO_LEI
    PROJETO_LEI_EXECUTIVO // Novo: Exclusivo da Prefeitura
    OFICIO
    MOCAO
    PARECER
    EMENDA_ADITIVA
    EMENDA_IMPOSITIVA
}

enum DocumentStatus {
    RASCUNHO
    ENVIADO
    AGUARDANDO_ASSINATURA
    REFAZER
    CANCELADO
    APROVADO
}

enum StatusTramitacao {
    AGUARDANDO_DESPACHO // Na fila da comissão (To Do) - Precisa de um relator
    EM_ANALISE // Relator designado, prazo correndo (In Progress)
    AGUARDANDO_VOTACAO // Relator deu o parecer, comissão vai votar internamente (Review)
    CONCLUIDO // Parecer emitido e aprovado pela comissão (Done)
    DEVOLVIDO // Devolvido ao autor para correções
}

enum CargoComissao {
    PRESIDENTE
    VICE_PRESIDENTE
    RELATOR
    MEMBRO
    SUPLENTE
}

enum TipoVotoParecer {
    ACOMPANHA_RELATOR
    DIVERGE_RELATOR
    ABSTENCAO
}

// === TABELAS ===

model Tenant {
    id              String   @id @default(uuid())
    name            String
    slug            String   @unique
    isActive        Boolean  @default(true) // Super Admin usa para bloquear/liberar
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    // Configurações Globais para Documentos Oficiais
    prefeitoNome    String? // Ex: "Maria Divanize Alves de Oliveira"
    palacioNome     String? // Ex: "Manoel Alves Bezerra"
    salaSessoesNome String? // Ex: "Vereador José Fernandes de Queiroz"
    cidadeEstado    String? // Ex: "Baraúna-RN"
    artigoIndicacao String? // Ex: "artigo 103, Parágrafo 1º do Regimento Interno"

    moduloPlenario  Boolean @default(false)
    moduloAtas      Boolean @default(false)
    moduloComissoes Boolean @default(true)

    logoCabecalho String? @db.Text
    marcaDagua    String? @db.Text

    enderecoRodape     String? // Ex: Rua do Horto Florestal, 506 Centro, Baraúna-RN // CEP: 59.695-000
    contatoRodape      String? // Ex: http://barauna.rn.leg.br/ // cmb.barauna@gmail.com
    comissoes          Comissao[]
    users              User[]
    gabinetes          Gabinete[]
    documents          Document[]
    secretariaDestinos SecretariaDestino[]
    sessoes            Sessao[]
}

model Gabinete {
    id        String   @id @default(uuid())
    name      String // Ex: "Gabinete do Vereador João"
    isActive  Boolean  @default(true)
    tenantId  String
    tenant    Tenant   @relation(fields: [tenantId], references: [id])
    createdAt DateTime @default(now())

    users     User[]
    documents Document[]
}

model User {
    id       String  @id @default(uuid())
    email    String  @unique
    password String
    name     String
    role     Role    @default(ASSESSOR)
    isActive Boolean @default(true) // Secretaria usa para bloquear acessos

    tenantId String
    tenant   Tenant @relation(fields: [tenantId], references: [id])

    gabineteId String? // Secretaria e Super Admin não têm gabinete, apenas Vereador/Assessor
    gabinete   Gabinete?            @relation(fields: [gabineteId], references: [id])
    partido    String?
    createdAt  DateTime             @default(now())
    updatedAt  DateTime             @updatedAt
    comissoes  ComissaoMembro[]
    relatorias TramitacaoComissao[] @relation("RelatorTramitacao")
    documents  Document[] // Documentos criados por este usuário específico

    tramitacaoComissaos TramitacaoComissao[]
    assinaturaParecers  AssinaturaParecer[]
}

model Document {
    id          String         @id @default(uuid())
    protocolNum Int
    year        Int
    type        DocumentType
    status      DocumentStatus @default(RASCUNHO)

    // Campos Gerais
    ementa  String
    content String  @db.Text
    texto   String? @db.Text // NOVO CAMPO: Artigos da Lei / Corpo do Documento

    // Campos Específicos para Indicações
    motivo            String? @db.Text
    secretariaDestino String?
    nomeSecretario    String?
    justificativa     String? @db.Text

    // Observações da Secretaria (quando manda refazer ou cancela)
    feedbackSecretaria String? @db.Text

    tenantId String
    tenant   Tenant @relation(fields: [tenantId], references: [id])

    gabineteId String?
    gabinete   Gabinete? @relation(fields: [gabineteId], references: [id])

    authorId String
    author   User   @relation(fields: [authorId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    sessaoId  String?
    sessao    Sessao?  @relation(fields: [sessaoId], references: [id])

    tramitacoes TramitacaoComissao[]

    @@unique([tenantId, type, protocolNum, year])
    @@index([tenantId])
}

model SecretariaDestino {
    id       String  @id @default(uuid())
    nome     String // Ex: "Secretaria Municipal de Obras"
    titular  String? // Ex: "João Silva"
    isActive Boolean @default(true)

    tenantId String
    tenant   Tenant @relation(fields: [tenantId], references: [id])

    createdAt DateTime @default(now())

    @@index([tenantId])
}

model Sessao {
    id         String   @id @default(uuid())
    numero     Int // Ex: 32 (32ª Sessão)
    tipo       String // Ex: "Ordinária" ou "Extraordinária"
    dataSessao DateTime // Data em que a sessão vai ocorrer
    status     String   @default("ABERTA") // ABERTA (A receber documentos) ou FECHADA (Pronta para o plenário)

    tenantId String
    tenant   Tenant @relation(fields: [tenantId], references: [id])

    documents Document[] // Documentos que entraram na pauta desta sessão

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([tenantId])
}

model RegistroVotacao {
    id         String   @id @default(uuid())
    tenantId   String
    documentId String
    sim        Int
    nao        Int
    abstencao  Int
    ausentes   Int
    votos      Json // Guarda o mapa: { "id-do-vereador": "SIM" }
    criadoEm   DateTime @default(now())
}

model SessaoPauta {
    id              String           @id @default(uuid())
    tenantId        String
    nomeSessao      String
    dataSessao      String
    itens           Json
    criadoEm        DateTime         @default(now())
    sessaoPresencas SessaoPresenca[]

    @@index([tenantId, criadoEm])
}

model SessaoPresenca {
    id            String      @id @default(uuid())
    tenantId      String
    sessaoPautaId String
    sessaoPauta   SessaoPauta @relation(fields: [sessaoPautaId], references: [id])
    vereadorId    String
    vereadorNome  String
    presente      Boolean     @default(false)
    criadoEm      DateTime    @default(now())

    @@unique([sessaoPautaId, vereadorId])
}

// === MÓDULO DE COMISSÕES (KANBAN) ===

model Comissao {
    id       String  @id @default(uuid())
    nome     String // Ex: "Comissão de Constituição, Justiça e Redação (CCJR)"
    sigla    String? // Ex: "CCJR"
    isActive Boolean @default(true)

    tenantId String
    tenant   Tenant @relation(fields: [tenantId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    membros     ComissaoMembro[]
    tramitacoes TramitacaoComissao[]

    @@index([tenantId])
}

// Tabela de Junção: Diz quais Vereadores fazem parte de qual Comissão e seus cargos
model ComissaoMembro {
    id    String        @id @default(uuid())
    cargo CargoComissao @default(MEMBRO)

    comissaoId String
    comissao   Comissao @relation(fields: [comissaoId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([comissaoId, userId]) // Um vereador só pode ter um cargo por comissão
}

// Esta é a tabela que representa o "Card" no Kanban do projeto
model TramitacaoComissao {
    id              String           @id @default(uuid())
    status          StatusTramitacao @default(AGUARDANDO_DESPACHO)
    prazoDias       Int              @default(15)
    // Controle de Prazos Legais (Geralmente 15 dias)
    prazoVencimento DateTime?

    // Conclusão
    resultado    String? // Ex: "FAVORÁVEL", "CONTRÁRIO", "COM_EMENDAS"
    parecerFinal String? @db.Text

    // Relacionamentos
    documentId String
    document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

    comissaoId String
    comissao   Comissao @relation(fields: [comissaoId], references: [id], onDelete: Cascade)

    // Vereador responsável por ler e emitir o parecer (pode estar vazio no início)
    relatorId String?
    relator   User?   @relation("RelatorTramitacao", fields: [relatorId], references: [id])

    createdAt   DateTime            @default(now())
    updatedAt   DateTime            @updatedAt
    user        User?               @relation(fields: [userId], references: [id])
    userId      String?
    assinaturas AssinaturaParecer[]

    @@index([documentId])
    @@index([comissaoId])
}

// Regista a assinatura/voto de cada membro da comissão no Parecer do Relator
model AssinaturaParecer {
    id            String          @id @default(uuid())
    tipoVoto      TipoVotoParecer @default(ACOMPANHA_RELATOR)
    justificativa String?         @db.Text // Útil se o vereador divergir (Voto em Separado)

    tramitacaoId String
    tramitacao   TramitacaoComissao @relation(fields: [tramitacaoId], references: [id], onDelete: Cascade)

    vereadorId String
    vereador   User   @relation(fields: [vereadorId], references: [id], onDelete: Cascade)

    assinadoEm DateTime @default(now())

    @@unique([tramitacaoId, vereadorId]) // Garante que o vereador só assine uma vez neste parecer
}
